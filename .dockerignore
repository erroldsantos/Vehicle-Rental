# Git files
.git
.gitignore

# IDE files
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Frontend directory (not needed in backend)
frontend/

# Development files
node_modules/
*.log

# Documentation
*.md
!README.md

# Test files
tests/

# Runtime files (will be generated)
runtime/logs/*
runtime/session/*
!runtime/logs/.gitkeep
!runtime/session/.gitkeep

# Composer files (will install fresh)
app/vendor/

# Environment files (will be set via Railway)
.env
.env.local
.env.example

# Uploaded files (for testing)
public/images/vehicles/*
public/images/licenses/*
!public/images/vehicles/.gitkeep
!public/images/licenses/.gitkeep

# Database files
*.sql
scheme/database/*.sql
!scheme/database/complete_schema.sql

# Lock files
package-lock.json
composer.lock

# Build files
Dockerfile
.dockerignore
